# Legacy MediaPipe RandomForest reproduction only.
# This file is intentionally not loaded by the production Compose service.
FALLDATA_AUX_INLINE_POSE_RF=false
FALLDATA_AUX_MEDIAPIPE_PYTHON=/app/.venv-mediapipe/bin/python
FALLDATA_AUX_MODEL_PYTHON=/app/.venv-falldata/bin/python
FALLDATA_AUX_MODEL_PATH=/app/models/legacy/falldata_mediapipe/FNF_RF_SMOTE_CAM_2.pkl

# Required manual mounts when reproducing the legacy path:
#   ./models -> /app/models:ro
#   ./.venv-mediapipe -> /app/.venv-mediapipe:ro
#   ./.venv-falldata -> /app/.venv-falldata:ro
