server {
    listen 7000;
    server_name _;

    # Re-resolve Docker service DNS so upstream container IP changes do not cause stale routing.
    resolver 127.0.0.11 ipv6=off valid=10s;
    resolver_timeout 2s;

    root /usr/share/nginx/html;
    index public-demo.html;

    location / {
        add_header Cache-Control "no-store";
        try_files $uri /public-demo.html;
    }

    location /public-api/ {
        set $public_api_upstream http://cctv-public-api:9000;
        rewrite ^/public-api/(.*)$ /$1 break;
        proxy_pass $public_api_upstream;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_set_header Host $host;
        proxy_set_header X-API-Key "${PUBLIC_API_KEY}";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /stream-api/ {
        return 410;
    }

    location /hls/ {
        return 410;
    }

    # HLS는 데모 라이브 표준 경로에서 제외한다.
    location ~ ^/([^/]+)/(index\.m3u8|.*\.ts|.*\.m4s|.*\.mp4|.*\.vtt) {
        return 410;
    }

    location /webrtc/ {
        set $webrtc_upstream http://cctv-media-server:8889;
        rewrite ^/webrtc/(.*)$ /$1 break;
        proxy_pass $webrtc_upstream;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        proxy_redirect ~^/(.*)$ /webrtc/$1;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /zone-api/ {
        set $zone_api_upstream http://cctv-ai-engine:8765;
        rewrite ^/zone-api/(.*)$ /$1 break;
        proxy_pass $zone_api_upstream;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /face-api/ {
        set $face_api_upstream http://cctv-ai-engine:8767;
        rewrite ^/face-api/(.*)$ /$1 break;
        proxy_pass $face_api_upstream;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /model-api/ {
        set $model_api_upstream http://cctv-ai-engine:8766;
        rewrite ^/model-api/(.*)$ /$1 break;
        proxy_pass $model_api_upstream;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
