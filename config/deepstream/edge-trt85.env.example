# B의 별도 소스 복사본과 batch=1 전용 엔진에서 사용하는 서비스 설정.
# 운영 .env를 복사하지 않는다. SDK 라이브러리·엔진·DB 경로는 격리 설치 경로로 지정한다.
USE_DEEPSTREAM=1
TENSORRT_EXPECTED_VERSION=8.5
TENSORRT_EXPECTED_CUDA_MAJOR=11
DS_CROP_POSE_ENABLED=0
DS_YOLO_TASK=pose
DS_YOLO_LABELS=person
DS_RTSP_TCP_ONLY=1
DS_RTSP_LATENCY_MS=200
DS_OUTPUT_MODE=fakesink
DS_PREVIEW_ENABLED=0
DS_HELMET_ENABLED=1
DS_PPHUMAN_SGIE_ENABLED=0
DS_FACE_ENABLED=0
DS_APPEARANCE_ENABLED=0
APPEARANCE_ENABLED=0
FACE_RECOGNITION_BACKEND=disabled
FALLDATA_AUX_ENABLED=0
METRICS_HOST=127.0.0.1
METRICS_PORT=18770
STREAM_API_ENABLED=0
STREAM_PORT=0
AI_ENGINE_RESTART_ON_PIPELINE_ERROR=0
# 시험 MQTT는 --mqtt-broker 127.0.0.1 --mqtt-port 18885 --mqtt-topic-prefix edge-lab/b/events.
# 카메라 URI/인증은 권한 0600인 별도 JSON으로만 전달하고 시험 종료 후 삭제한다.
