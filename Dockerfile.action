# ==============================================================================
# Dockerfile.action — 경량 서비스 전용
#
# 대상 서비스: cctv-edgex-adapter, cctv-alert-api, cctv-action-layer
#              (AI 추론 불필요 — torch/ultralytics/opencv 제외)
#
# 사용 플랫폼: x86-64 (기본) 및 ARM64 (Jetson 포함)
#              python:3.10-slim-bookworm 은 multi-arch 이미지이므로 별도 수정 불필요
# ==============================================================================

FROM python:3.10-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# 시스템 의존성 최소화
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Python 의존성: requirements-action.txt 만 설치 (~30MB)
WORKDIR /build
COPY requirements-action.txt .
RUN pip install --no-cache-dir -r requirements-action.txt

# 보안 사용자
RUN groupadd -r -g 2001 cctv && useradd -r -u 2002 -g cctv cctv

WORKDIR /app

RUN mkdir -p /app/models /app/event_backup && chown -R cctv:cctv /app

COPY --chown=cctv:cctv src         /app/src
COPY --chown=cctv:cctv runners     /app/runners
COPY --chown=cctv:cctv kuiper      /app/kuiper
COPY --chown=cctv:cctv models/model_manifest.json /app/models/model_manifest.json
COPY --chown=cctv:cctv requirements-action.txt /app/

RUN chown -R cctv:cctv /app

USER cctv

CMD ["python", "--help"]
