# =============================================================================
# CCTV 플랫폼 환경 변수 설정 예시
# docker-compose.yml / docker-compose.monitoring.yml 기준 파일입니다.
# .env 파일로 복사한 뒤 실제 값으로 수정하세요.
#   cp .env.example .env
# =============================================================================

# =============================================================================
# [AI Engine] cctv-ai-engine 컨테이너
# =============================================================================

# 모델 경로 (컨테이너 내부 경로)
HELMET_MODEL_PATH=models/helmet_model_ver0.5.pt
POSE_MODEL_PATH=models/yolov8n-pose.pt

# AI 추론 디바이스
DEVICE=cpu          # cpu | cuda | mps

# 감지 신뢰도
HELMET_CONFIDENCE=0.5
POSE_CONFIDENCE=0.3

# 낙상 감지 (관절 기반)
FALL_ANGLE_THRESHOLD=45.0   # 몸 각도 임계값 (도)
FALL_HEIGHT_RATIO=0.3        # 머리 높이 비율
FALL_SUSTAINED_SECONDS=10.0  # 낙상 상태가 이 시간 이상 유지되어야 이벤트 전송
FALL_GAP_RESET_SECONDS=2.0
FALL_RESEND_COOLDOWN=60.0

# 낙상 보조 검증 모델 (공공 falldata RF 모델)
# 기본은 비활성화입니다. 먼저 shadow로 현장 로그를 확인한 뒤 confirm을 사용하세요.
FALLDATA_AUX_ENABLED=false
FALLDATA_AUX_MODE=shadow       # shadow | confirm
FALLDATA_AUX_THRESHOLD=0.7
FALLDATA_AUX_FALL_CLASS_INDEX=0
FALLDATA_AUX_MIN_NONZERO_FRAMES=30
FALLDATA_AUX_BUFFER_FRAMES=600
FALLDATA_AUX_MAX_EXTRACT_FRAMES=120
FALLDATA_AUX_TIMEOUT_SECONDS=30
FALLDATA_AUX_COOLDOWN_SECONDS=10
# confirm 모드에서도 aux 실패/의존성 누락/프레임 부족이면 원본 낙상 이벤트를 발행합니다.
FALLDATA_AUX_FAIL_OPEN_ON_UNAVAILABLE=true
FALLDATA_AUX_CONFIRM_BORDERLINE=false
# 선택: aux 확인 대기 범위를 fall_score 기준으로 확장합니다. 공백이면 DS_FALL_SCORE_THRESHOLD 이하만 대기합니다.
# FALLDATA_AUX_CONFIRM_MAX_FALL_SCORE=6.0
# 선택: compare 모델이 명확히 반대하는 경우 aux 확인 낙상 발행을 취소합니다.
FALLDATA_AUX_COMPARE_VETO_ENABLED=false
# 선택: compare veto를 높은 fall_score 구간에만 적용합니다. 공백이면 모든 aux 확인 대상에 적용합니다.
# FALLDATA_AUX_COMPARE_VETO_MIN_FALL_SCORE=5.0
# 로컬 실행 기준. 컨테이너 운영 시 컨테이너 내부 경로로 맞춰야 합니다.
FALLDATA_AUX_MEDIAPIPE_PYTHON=.venv-mediapipe/bin/python
FALLDATA_AUX_MODEL_PYTHON=.venv-falldata/bin/python
# 모델 경로는 기본값이 공공 falldata 패키지 경로를 가리킵니다.
# 컨테이너 운영 시에는 공백/한글 경로 처리를 피하도록 내부 경로를 별도로 지정하세요.
# FALLDATA_AUX_MODEL_PATH=falldata/2. AI학습모델파일/영상/낙상분류/FNF_RF_SMOTE_CAM_1.pkl
# 선택: 운영 판정에는 쓰지 않고 shadow 로그에 후보 모델 결과를 함께 기록합니다.
# FALLDATA_AUX_COMPARE_MODEL_PATH=models/experiments/falldata_sample_rf_max120_guarded.pkl

# DeepStream pose 낙상 점수 기준. 낮추면 민감해지고, 올리면 오탐이 줄어듭니다.
DS_FALL_SCORE_THRESHOLD=3.0
# 후면/측면의 바닥 착좌형 낙상 실험 옵션입니다. 기본값 false 권장.
DS_FALL_ENABLE_FOLDED_POSE=false
DS_FALL_SUPPRESS_SITTING_LIKE_POSE=false
DS_FALL_SITTING_LIKE_ASPECT_RATIO=1.45

# DeepStream falldata shadow 학습 후보 수집
FALL_SHADOW_REVIEW_LOG_PATH=/app/data/fall_dataset/annotations/review.jsonl
FALL_SHADOW_SAVE_CLIPS=false
FALL_SHADOW_CLIP_DIR=/app/data/fall_dataset/clips/pending
# 후면/측면 바닥 착좌형 미탐 후보를 알람 없이 JSONL에 수집합니다.
FALL_SHADOW_NEAR_MISS_LOG=false
FALL_SHADOW_NEAR_MISS_COOLDOWN_SECONDS=10

# RTSP 재연결
RTSP_RECONNECT_INTERVAL=5
RTSP_MAX_RETRIES=5

# 기타
APP_ENV=development
TARGET_FPS=30
DISPLAY=false
ZONE_DETECTION=false
COLLECT_DATASET=false

# =============================================================================
# [MQTT] 공통 — 모든 서비스가 읽는 브로커 접속 정보
# =============================================================================

MQTT_BROKER=edgex-mqtt-broker   # Docker 내부: edgex-mqtt-broker / 로컬: localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=

# =============================================================================
# [Kuiper Rule Engine] cctv-kuiper-rule-loader 컨테이너
# =============================================================================

KUIPER_API=http://edgex-kuiper:59720
KUIPER_RETRY_COUNT=20
KUIPER_RETRY_DELAY=2

# CCTV AI 임계값
INTRUSION_CONFIDENCE=0.7    # 침입 감지 신뢰도 (0.0~1.0)
CRITICAL_CONFIDENCE=0.9     # 고위험 라우팅 신뢰도 (0.0~1.0)
PERSIST_HIT_COUNT=5         # 5초 윈도우 내 최소 검출 횟수

# IoT 센서 임계값
TILT_THRESHOLD=10.0         # 기울기 경보 임계값 (도)
TEMP_HIGH_THRESHOLD=60.0    # 고온 경보 임계값 (°C)

# =============================================================================
# [Action Layer] cctv-action-layer 컨테이너
# =============================================================================

# 알람 쿨다운 (초) — 동일 카메라·이벤트 유형 중복 알람 방지
ACTION_ALARM_COOLDOWN=10

# ── 스피커 (InterM HTTP REST + Digest 인증) ──────────────────────────────────
# 사용하지 않으면 SPEAKER_HOST를 비워두세요 (자동 비활성화)
SPEAKER_HOST=
SPEAKER_PORT=80
SPEAKER_USER=admin
SPEAKER_PASSWORD=

# TTS 발화 파라미터 (기본값으로도 충분)
SPEAKER_VOLUME=10
# SPEAKER_TTS_LANGUAGE=kor
# SPEAKER_TTS_GENDER=female
# SPEAKER_TTS_PITCH=100
# SPEAKER_TTS_SPEED=100

# ── 전광판 (Dabit Metrix TCP 소켓) ───────────────────────────────────────────
# 사용하지 않으면 SIGNBOARD_HOST를 비워두세요 (자동 비활성화)
SIGNBOARD_HOST=
SIGNBOARD_PORT=5000
# SIGNBOARD_BRIGHTNESS=10
# SIGNBOARD_TEXT_COLOR=7
# SIGNBOARD_BACK_COLOR=0

# ── 경광등 (InterM HTTP REST + Digest 인증) ──────────────────────────────────
# 사용하지 않으면 SIREN_HOST를 비워두세요 (자동 비활성화)
SIREN_HOST=
SIREN_PORT=80
SIREN_USER=
SIREN_PASSWORD=
# SIREN_AUTO_STOP=10           # 자동 정지 시간 (초)

# REST 수신 서버 (수동 승인 API)
REST_ENABLED=true
REST_HOST=0.0.0.0
REST_PORT=8080

# =============================================================================
# [Alert API] cctv-alert-api 컨테이너
# =============================================================================

# 이벤트 로그 경로 (컨테이너 내부)
# ALERT_LOG_PATH=/app/data/logs/alert_api_events.jsonl
# SENSOR_LOG_PATH=/app/data/logs/sensor_readings.jsonl
# SENSOR_DEVICE_MAP_PATH=/app/config/sensor_devices.json

# =============================================================================
# [Public API] cctv-public-api 컨테이너
# =============================================================================

# 필수: 프로덕션에서는 반드시 강력한 무작위 값으로 설정할 것
# ./scripts/ops/ensure_public_api_key.sh .env 로 자동 생성 가능
PUBLIC_API_KEY=
PUBLIC_API_ALLOW_QUERY_KEY=0
REQUIRE_PUBLIC_API_KEY=0
PUBLIC_API_BIND_HOST=127.0.0.1
PUBLIC_DEMO_BIND_HOST=127.0.0.1

# CORS 허용 오리진 (쉼표 구분, 비워두면 개발 편의상 전체 허용)
# 프로덕션 예: CORS_ORIGINS=https://dashboard.example.com,https://admin.example.com
CORS_ORIGINS=
REQUIRE_CORS_ORIGINS=0

# 내부 서비스 URL (Docker 내부 서비스명 사용)
ACTION_LAYER_URL=http://cctv-action-layer:8080
ALERT_API_URL=http://cctv-alert-api:8000

# Action Layer SQLite 저장 경로
DB_PATH=/app/data/runtime/action_events.db

# 로그 공유 경로 (data/logs)
ALERT_LOG_PATH=/app/data/logs/alert_api_events.jsonl
SENSOR_LOG_PATH=/app/data/logs/sensor_readings.jsonl
ALERT_FALLBACK_LOG=/app/data/logs/public_api_fallback.jsonl

# 외형 검색 DB
APPEARANCES_DB=/app/data/runtime/appearances.db
APPEARANCE_ENABLED=true
APPEARANCE_BACKEND=hsv
APPEARANCE_COLOR_MODEL_PATH=models/appearance_color_yolov8n.onnx
APPEARANCE_COLOR_LABEL_MAP_PATH=config/appearance_color_labels.json
APPEARANCE_COLOR_INPUT_SIZE=160
APPEARANCE_COLOR_SCORE_THRESHOLD=0.75
# 속성 모델 사용 시:
# APPEARANCE_BACKEND=pphuman
# APPEARANCE_MODEL_PATH=models/pphuman_attribute.onnx
# APPEARANCE_LABEL_MAP_PATH=config/appearance_pphuman_labels.example.json
# APPEARANCE_RUNTIME=onnxruntime
# Jetson ONNX Runtime 문제가 있으면 Paddle 원본 모델을 직접 사용:
# APPEARANCE_MODEL_PATH=models/pphuman_attribute_src/PP-LCNet_x1_0_pedestrian_attribute_infer
# APPEARANCE_RUNTIME=paddle
# APPEARANCE_INPUT_SIZE=224
# APPEARANCE_SCORE_THRESHOLD=0.5
# DeepStream SGIE로 PA100K TensorRT engine을 붙일 때:
# APPEARANCE_BACKEND=hsv
# DS_PPHUMAN_SGIE_ENABLED=1
# DS_PPHUMAN_INFER_CONFIG=config/deepstream/config_infer_pa100k.txt
# APPEARANCE_LABEL_MAP_PATH=config/appearance_pa100k_labels.json
# Worker에서 PA100K TensorRT engine을 직접 추론할 때:
# DS_PPHUMAN_SGIE_ENABLED=0
# APPEARANCE_BACKEND=pphuman
# APPEARANCE_MODEL_PATH=models/pa100k_resnet50_attr.engine
# APPEARANCE_RUNTIME=tensorrt
APPEARANCE_CROP_DIR=/app/data/runtime/appearance_crops
APPEARANCE_SAVE_CROPS=false
# PP-Human gender는 female score 하나라 애매한 구간은 unknown으로 둔다.
APPEARANCE_GENDER_FEMALE_MIN_SCORE=0.75
APPEARANCE_GENDER_MALE_MAX_SCORE=0.25
# 같은 track에서 이 횟수 이상 관측된 뒤에만 gender를 확정한다.
APPEARANCE_GENDER_MIN_SAMPLES=3
# 같은 track에서 색상/boolean 속성을 안정화한다. 값이 클수록 덜 흔들리지만 반응이 늦어진다.
APPEARANCE_COLOR_SMOOTHING_WINDOW=12
APPEARANCE_COLOR_MIN_SAMPLES=3
APPEARANCE_BOOL_SMOOTHING_WINDOW=8
APPEARANCE_BOOL_MIN_SAMPLES=3
APPEARANCE_BOOL_TRUE_RATIO=0.6
# 외형검색 저장 crop 주변 여백 비율. 0.6이면 bbox 가로/세로의 60%만큼 주변 맥락 포함.
APPEARANCE_CROP_CONTEXT_RATIO=0.6
DS_YOLO_LABELS=person
DS_POSE_CONFIDENCE=0.25
DS_FALL_ANGLE_HORIZONTAL=55
DS_FALL_ANGLE_INVERTED=125
DS_FALL_BBOX_ASPECT_RATIO=1.35
DS_FALL_SPAN_BBOX_ASPECT_RATIO=1.20
DS_FALL_KEYPOINT_SPAN_RATIO=0.55
DS_FALL_SUPPRESS_SITTING_LIKE_POSE=false
DS_FALL_SITTING_LIKE_ASPECT_RATIO=1.45
DS_FALL_MIN_KEYPOINT_CONFIDENCE=0.25
DS_FALL_MIN_HIP_CONFIDENCE=0.25
DS_FACE_ENABLED=1
DS_APPEARANCE_ENABLED=1
DS_HELMET_ENABLED=1
DS_APPEARANCE_CONDITION_REFRESH_SEC=10
DS_PREVIEW_MAX_FPS=15
# DeepStream H.264 라이브 출력 튜닝. POC 보정은 Python 버퍼 복사를 유발하므로 기본 비활성화.
DS_H264_WIDTH=1280
DS_H264_HEIGHT=720
DS_H264_BITRATE=4000000
DS_H264_IFRAME_INTERVAL=15
DS_H264_IDR_INTERVAL=15
DS_H264_POC_FIX_ENABLED=false
DS_H264_POC_TYPE=2
FACE_DEVICE=cpu
FACE_SNAPSHOT_ENABLED=false
FACE_SNAPSHOT_DIR=/app/data/runtime/face_snapshots
FACE_SNAPSHOT_COOLDOWN_SEC=30

# =============================================================================
# [aiot-parser] 파서 서비스 (parser-python/.env 에도 복사)
# =============================================================================

AIOT_DB_NAME=aiot_sensor
AIOT_DB_USER=postgres
AIOT_DB_PASSWORD=

EDGEX_MQTT_HOST=edgex-mqtt-broker
EDGEX_MQTT_PORT=1883
EDGEX_CORE_DATA_URL=http://edgex-core-data:59880
EDGEX_OUTBOX_DB=/data/runtime/event_outbox.db
EDGEX_OUTBOX_RETRY_INTERVAL=30

# =============================================================================
# [Monitoring] Prometheus + Grafana
# =============================================================================

# Grafana 관리자 비밀번호 (프로덕션에서는 반드시 강력한 값으로 설정)
GRAFANA_ADMIN_PASSWORD=

# 내부 서비스 간 공유 시크릿 (public-api ↔ action-layer ↔ alert-api)
# 생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 미설정 시 검증 건너뜀 (개발 환경 허용)
INTERNAL_SERVICE_TOKEN=

# Stream API 보호. REQUIRE_STREAM_API_TOKEN=1이면 /cameras, /stream, /snapshot에
# X-Stream-Token 또는 X-Internal-Token 헤더가 필요합니다. STREAM_API_TOKEN이 비어 있으면
# INTERNAL_SERVICE_TOKEN을 fallback으로 사용합니다.
STREAM_API_TOKEN=
REQUIRE_STREAM_API_TOKEN=0

# MJPEG 라이브 스트림 튜닝값. 프레임 끊김이 있으면 FPS/해상도/품질을 먼저 낮춰보세요.
STREAM_FPS=15
STREAM_WIDTH=960
STREAM_HEIGHT=540
STREAM_JPEG_QUALITY=65

# Rate limiting 비활성화 (개발 시 false로 설정 가능)
RATE_LIMIT_ENABLED=true

# EdgeX 양방향 AI 검색/미디어 요청 (기본 비활성화, Shadow Pilot에서만 활성화)
AIOT_COMMANDS_ENABLED=false
AIOT_JETSON_ID=jetson-01
AIOT_COMMAND_TOPIC_PREFIX=edgex/commands/cctv
AIOT_ALLOWED_UPLOAD_HOSTS=
AIOT_QUERY_MAX_RESULTS=20
AIOT_LIVE_WINDOW_SECONDS=30
AIOT_METRICS_PORT=9105
