# 환경 변수 설정 예시
# .env 파일로 저장하여 사용

# 모델 경로
HELMET_MODEL_PATH=models\helmet_model_ver0.5.pt
POSE_MODEL_PATH=models\yolov8n-pose.pt

# 디바이스 설정
DEVICE=cpu  # cpu 또는 cuda

# 감지 설정
HELMET_CONFIDENCE=0.5
POSE_CONFIDENCE=0.3  # 사람 감지 - 낮게 설정하여 헬멧 쓴 사람도 감지

# 낙상 감지 설정 (관절 기반)
FALL_ANGLE_THRESHOLD=45.0  # 몸 각도 임계값 (도)
FALL_HEIGHT_RATIO=0.3  # 머리 높이 비율

# 카메라 설정
RTSP_RECONNECT_INTERVAL=5
RTSP_MAX_RETRIES=5

# 기타
TARGET_FPS=30
DISPLAY=false
ZONE_DETECTION=false
COLLECT_DATASET=false

# Kuiper Rule Engine 설정
KUIPER_API_URL=http://localhost:9081
KUIPER_RULES_FILE=kuiper/rules/cctv_intrusion_rules.json
KUIPER_INTRUSION_CONFIDENCE=0.7
KUIPER_CRITICAL_CONFIDENCE=0.9
KUIPER_PERSIST_HIT_COUNT=5

# Action Layer 설정
# (docker-compose.yml 의 cctv-action-layer 서비스에서 참조됩니다)

# ── 스피커 (InterM HTTP REST + Digest 인증) ─────────────────
SPEAKER_HOST=192.168.88.92
SPEAKER_PORT=80
SPEAKER_USER=admin
SPEAKER_PASSWORD=sawwaveap123@
SPEAKER_VOLUME=10
# TTS 설정 (기본값은 docker-compose.yml 에 고정)

# ── 전광판 (Dabit TCP 소켓 5000번 포트) ────────────────────
# 미사용 시 빈 문자열로 두면 자동 비활성화
SIGNBOARD_HOST=192.168.88.91
SIGNBOARD_PORT=5000

# ── 경광등 (InterM HTTP REST + Digest 인증) ─────────────────
# 미사용 시 빈 문자열로 두면 자동 비활성화
SIREN_HOST=
SIREN_PORT=80
SIREN_USER=
SIREN_PASSWORD=

# ── 알람 쿨다운 (초) ─────────────────────────────────────────
ACTION_ALARM_COOLDOWN=10
ACTION_SPEAKER_TTS_VOLUME=10
ACTION_SPEAKER_WEBHOOK_URL=http://localhost:9100/play
ACTION_SPEAKER_COMMAND=
ACTION_ALARM_COOLDOWN=3
