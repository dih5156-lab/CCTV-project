# ==============================================================================
# Jetson Orin AGX 전용 CCTV 파이프라인 Dockerfile
#
# 대상 환경: NVIDIA Jetson Orin AGX
#            JetPack 6.2 (L4T R36.4.x) / CUDA 12.6 / TensorRT 10.3.0 / Python 3.10
#
# 베이스 이미지: nvcr.io/nvidia/l4t-jetpack:r36.4.0
#   - CUDA 12.6, cuDNN 9.x, TensorRT 10.3.0, VPI 포함 (JetPack 6.2 공식 컨테이너)
#   - Ubuntu 22.04 aarch64 기반
#
# JetPack 버전별 베이스 이미지 매핑:
#   JetPack 6.2 (L4T R36.4.x): nvcr.io/nvidia/l4t-jetpack:r36.4.0  ← 현재 사용
#   JetPack 6.1 (L4T R36.3.x): nvcr.io/nvidia/l4t-jetpack:r36.3.0
#   JetPack 6.0 (L4T R36.2.x): nvcr.io/nvidia/l4t-jetpack:r36.2.0
#   JetPack 5.1 (L4T R35.4.x): nvcr.io/nvidia/l4t-jetpack:r35.4.1
# ==============================================================================

FROM nvcr.io/nvidia/l4t-jetpack:r36.4.0

LABEL maintainer="CCTV-project" \
      description="Jetson Orin AGX CCTV AI engine (CUDA 12.6 / TensorRT 10.3.0 가속)" \
      jetpack="6.2" \
      l4t="r36.4.0" \
      cuda="12.6" \
      tensorrt="10.3.0"

ARG PYDS_WHEEL_URL="https://github.com/NVIDIA-AI-IOT/deepstream_python_apps/releases/download/v1.2.0/pyds-1.2.0-cp310-cp310-linux_aarch64.whl"

# ── 환경 변수 ─────────────────────────────────────────────────────────────────
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH=/usr/local/cuda-12.6/bin:/usr/local/cuda/bin:${PATH} \
    LD_LIBRARY_PATH=/usr/local/cuda-12.6/lib64:/usr/local/cuda/lib64:/usr/local/lib/python3.10/dist-packages/torch/lib:${LD_LIBRARY_PATH:-} \
    CUDA_HOME=/usr/local/cuda-12.6

# ── 시스템 의존성 ──────────────────────────────────────────────────────────────
# Python 3.10 + pip + OpenCV 헤드리스 런타임 + GStreamer 하드웨어 디코더
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    python3-setuptools \
    python3-wheel \
    build-essential \
    # OpenCV 런타임 라이브러리
    libglib2.0-0 \
    libgomp1 \
    libgl1 \
    libgles2 \
    # GStreamer (Jetson 하드웨어 디코딩: nvv4l2decoder, nvivafilter)
    gstreamer1.0-tools \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-ugly \
    gstreamer1.0-libav \
    libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev \
    python3-gi \
    python3-gst-1.0 \
    gir1.2-gstreamer-1.0 \
    # DeepStream host runtime plugins loaded from /opt/nvidia/deepstream need these Ubuntu libs
    libyaml-cpp0.7 \
    libjsoncpp25 \
    libgstrtspserver-1.0-0 \
    # 네트워크 / 유틸
    curl \
    wget \
    # PyTorch 호스트 마운트 시 필요한 공유 라이브러리
    libopenblas-dev \
    libopenblas0 \
    && rm -rf /var/lib/apt/lists/*

# pip 최신화 및 python3 → python 심링크
RUN pip3 install --no-cache-dir --upgrade pip setuptools wheel && \
    ln -sf /usr/bin/python3 /usr/local/bin/python

# ── PyTorch / torchvision은 런타임 bind mount로 주입 ─────────────────────────
# Jetson GPU wheel은 호스트의 큰 디스크에 설치해두고 docker-compose.jetson.yml에서
# /usr/local/lib/python3.10/dist-packages 로 마운트한다. 빌드 중 PyPI torch를 받으면
# CUDA 13 계열 대용량 wheel까지 끌려와 저장공간과 시간을 크게 낭비한다.
RUN echo "Skipping torch/torchvision install; Jetson GPU wheels are mounted at runtime."

# ── Python 의존성 설치 ─────────────────────────────────────────────────────────
# torch / torchvision / torchaudio 는 런타임 마운트 → requirements에서 제외
# opencv-python → opencv-python-headless (Jetson 헤드리스 환경)
WORKDIR /build
COPY requirements-ai.txt .
COPY requirements-face-jetson.txt .

RUN grep -vE '^(ultralytics|torch|torchvision|torchaudio|opencv-python|openCV-python|numpy)([>=<!~ ]|$)' requirements-ai.txt \
    > requirements-ai-jetson.txt && \
    pip3 install --no-cache-dir -r requirements-ai-jetson.txt && \
    pip3 install --no-cache-dir \
        "numpy<2.0.0" \
        "opencv-python-headless>=4.8.0" \
        "matplotlib>=3.3.0" \
        "pyyaml>=5.3.1" \
        "scipy>=1.4.1" \
        "psutil>=5.8.0" \
        "polars>=0.20.0" \
        "filelock" \
        "typing-extensions>=4.10.0" \
        "sympy>=1.13.3" \
        "networkx>=2.5.1" \
        "jinja2" \
        "fsspec>=0.8.5" && \
    pip3 install --no-cache-dir --no-deps "ultralytics-thop>=2.0.18" && \
    pip3 install --no-cache-dir --no-deps "ultralytics>=8.0.0"

# pydantic 버전 보장 (speaker-edgex dtos 의존성)
RUN pip3 install --no-cache-dir "pydantic>=2.5.0,<3.0.0"

# NumPy 1.x 고정 (PyTorch JP6.2 빌드는 NumPy 1.x 기준으로 컴파일됨)
# NumPy 2.x 사용 시 ImportError: _ARRAY_API not found 발생
RUN pip3 install --no-cache-dir "numpy<2.0.0"

# ── 얼굴 인식 추가 의존성 ─────────────────────────────────────────────
# InsightFace는 aarch64에서 일부 Cython 확장을 빌드하므로 Cython을 먼저 보장한다.
RUN pip3 install --no-cache-dir "Cython>=3.0.0" && \
    pip3 install --no-cache-dir -r requirements-face-jetson.txt

# ── DeepStream Python bindings (pyds) ────────────────────────────────────────
# DeepStream 7.1 / Ubuntu 22.04 / Python 3.10 / Jetson(aarch64) 공식 wheel.
# pyds 가 없으면 USE_DEEPSTREAM=1 설정 시 VideoProcessor 로 폴백된다.
RUN pip3 install --no-cache-dir "${PYDS_WHEEL_URL}"

# ── libcusparseLt 심링크 설정 ──────────────────────────────────────
# l4t-jetpack 베이스에 libcusparseLt가 /usr/lib/aarch64-linux-gnu/libcusparseLt/13/ 에 있지만
# PyTorch torch._C가 libcusparseLt.so.0 를 /usr/local/cuda/lib64 에서 탐색
RUN CUSPARSELT_SRC=$(find /usr/lib/aarch64-linux-gnu/libcusparseLt -name "libcusparseLt.so.0" 2>/dev/null | head -1); \
    if [ -n "$CUSPARSELT_SRC" ]; then \
        ln -sf "$CUSPARSELT_SRC" /usr/local/cuda/lib64/libcusparseLt.so.0; \
        echo "libcusparseLt.so.0 심링크 생성: $CUSPARSELT_SRC → /usr/local/cuda/lib64/libcusparseLt.so.0"; \
    else \
        echo "WARNING: libcusparseLt.so.0 를 찾지 못했습니다"; \
    fi

# ── 보안 사용자 ───────────────────────────────────────────────────────────────
RUN id cctv 2>/dev/null \
    || (groupadd -r -g 2001 cctv && useradd -r -u 2002 -g cctv cctv)

# ── 앱 코드 복사 ──────────────────────────────────────────────────────────────
WORKDIR /app

RUN mkdir -p /app/models /app/event_backup \
    && chown -R cctv:cctv /app

COPY --chown=cctv:cctv src         /app/src
COPY --chown=cctv:cctv main.py     /app/main.py
COPY --chown=cctv:cctv runners     /app/runners
COPY --chown=cctv:cctv kuiper      /app/kuiper
COPY --chown=cctv:cctv config      /app/config
COPY --chown=cctv:cctv models/model_manifest.json /app/models/model_manifest.json
COPY --chown=cctv:cctv requirements.txt /app/

RUN chown -R cctv:cctv /app

# ── 기본 진입점 ───────────────────────────────────────────────────────────────
CMD ["python3", "main.py", "--help"]
