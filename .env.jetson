# ==============================================================================
# .env.jetson — Jetson Orin AGX 올인원 배포 환경 변수
#
# 사용 방법:
#   docker compose -f docker-compose.jetson.yml --env-file .env.jetson up -d --build
#
# 필수 수정 항목:
#   L4T_TAG  ← Jetson 에서 `cat /etc/nv_tegra_release` 로 JetPack 버전 확인
# ==============================================================================

# ── JetPack / L4T 버전 ────────────────────────────────────────────────────────
# JetPack 6.x (L4T R36.x):  r36.2.0-pth2.1-py3  ← 기본값
# JetPack 5.x (L4T R35.x):  r35.4.1-pth2.1-py3
L4T_TAG=r36.2.0-pth2.1-py3

# ── AI 추론 설정 ──────────────────────────────────────────────────────────────
# GStreamer 하드웨어 디코딩 활성화 (nvv4l2decoder 사용)
USE_GSTREAMER=1
USE_DEEPSTREAM=1

# 추론 디바이스 (Jetson 은 항상 cuda)
AI_DEVICE=cuda

# 헬멧 감지 신뢰도 임계값 (0.0~1.0)
CONFIDENCE=0.5

# 사람/낙상 포즈 감지 신뢰도 임계값 (0.0~1.0)
POSE_CONFIDENCE=0.3

# AI 추론 주기 (매 N 프레임마다 실행, 성능-정확도 트레이드오프)
# Jetson Orin AGX (JetPack 6.2, CUDA 12.6) 권장: 2 (30fps 기준 약 10fps 추론)
FRAME_SKIP=2

# 목표 FPS
FPS=30

# RTSP 프레임 버퍼 크기
# 1: 최신 프레임만 유지 (지연 최소화, 지터 환경에서 드롭 증가)
# 2: 네트워크 지터 완충 (일반 CCTV 환경 권장 기본값)
# 3: 불안정한 네트워크 환경용
RTSP_BUFFER_SIZE=2

# 이벤트 디바운싱 간격(초) — 동일 이벤트 중복 발행 방지
DEBOUNCE=3.0

# DeepStream MQTT 이벤트 최소 발행 간격(초)
# 추론은 계속 수행하되 동일 카메라·동일 이벤트의 MQTT 폭주를 방지합니다.
DS_EVENT_MIN_INTERVAL_SEC=3.0

# DeepStream YOLO tensor parser 설정
# yolov8n-pose.engine 클래스: 0=person, keypoints=17x3
DS_YOLO_TASK=pose
DS_YOLO_CLASS_IDS=0
DS_YOLO_LABELS=person
DS_YOLO_CONFIDENCE=0.35

# DeepStream 추가 helmet/head detector
# pose gie-id=1, helmet/head gie-id=2 로 tensor output을 구분합니다.
DS_POSE_GIE_ID=1
DS_HELMET_ENABLED=1
DS_HELMET_GIE_ID=2
DS_HELMET_CLASS_IDS=0,1
DS_HELMET_LABELS=helmet,head
DS_HELMET_CONFIDENCE=0.35
DS_FACE_ENABLED=1
DS_APPEARANCE_ENABLED=1
DS_APPEARANCE_CONDITION_REFRESH_SEC=10
FACE_DEVICE=cpu
# Jetson 컨테이너의 InsightFace/ONNX Runtime native abort 방지.
# 호환 wheel을 별도 검증하기 전까지는 OpenCV 폴백을 기본값으로 사용한다.
FACE_RECOGNITION_BACKEND=opencv
FACE_SNAPSHOT_ENABLED=false
FACE_SNAPSHOT_DIR=/app/data/face_snapshots
FACE_SNAPSHOT_COOLDOWN_SEC=30
APPEARANCE_ENABLED=true
APPEARANCE_BACKEND=hsv
APPEARANCES_DB=/app/data/appearances.db
APPEARANCE_CROP_DIR=/app/data/appearance_crops
APPEARANCE_SAVE_CROPS=false

# DeepStream 브라우저 preview
# URL: http://<Jetson-IP>:8769/stream/camera_1
DS_PREVIEW_ENABLED=1
STREAM_API_ENABLED=1
STREAM_PORT=8769
STREAM_FPS=15
STREAM_JPEG_QUALITY=75

# ── Zone 설정 API (카메라별 위험구역 설정) ────────────────────────────────────
# 0 이면 비활성화, 8765 로 설정하면 http://<Jetson-IP>:8765 에서 접근 가능
ZONE_API_PORT=0

# ── Action Layer: 알람 쿨다운(초) ────────────────────────────────────────────
ACTION_ALARM_COOLDOWN=10
# DeepStream 탐지 이벤트도 전광판/스피커 알람 대상으로 처리합니다.
SUBSCRIBE_TOPICS=cctv/rules/intrusion/filtered,cctv/rules/intrusion/persisted,cctv/rules/intrusion/critical,cctv/ai/events/+/person,cctv/ai/events/+/helmet,cctv/ai/events/+/head,cctv/ai/events/+/fall_detected,cctv/ai/events/+/unsafe_behavior,cctv/ai/events/+/zone_entered,cctv/ai/events/+/zone_dwelling,cctv/ai/events/+/zone_object_detected,cctv/ai/events/+/crowd_warning,aiot/rules/sensor/tilt,aiot/rules/sensor/temperature,aiot/rules/sensor/vibration
ALARM_TOPICS=cctv/rules/intrusion/persisted,cctv/rules/intrusion/critical,cctv/ai/events/+/person,cctv/ai/events/+/helmet,cctv/ai/events/+/head,cctv/ai/events/+/fall_detected,cctv/ai/events/+/unsafe_behavior,cctv/ai/events/+/zone_entered,cctv/ai/events/+/zone_dwelling,cctv/ai/events/+/zone_object_detected,cctv/ai/events/+/crowd_warning,aiot/rules/sensor/tilt,aiot/rules/sensor/temperature,aiot/rules/sensor/vibration

# ── AIoT TLV Parser PostgreSQL ───────────────────────────────────────────────
AIOT_DB_NAME=aiot_sensor
AIOT_DB_USER=postgres
AIOT_DB_PASSWORD=postgres
AIOT_ALLOW_UNKNOWN_DEVICES=true

# ── 스피커 (InterM HTTP REST + Digest 인증) ───────────────────────────────────
# 비어 있으면 스피커 기능 비활성화
SPEAKER_HOST=192.168.88.92
SPEAKER_PORT=80
SPEAKER_USER=admin
SPEAKER_PASSWORD=
SPEAKER_VOLUME=10
SPEAKER_TTS_LANGUAGE=kor
SPEAKER_TTS_GENDER=female
SPEAKER_TTS_PITCH=100
SPEAKER_TTS_SPEED=100
SPEAKER_TTS_VOLUME=1

# ── 전광판 (Dabit TCP 소켓) ──────────────────────────────────────────────────
# 비어 있으면 전광판 기능 비활성화
SIGNBOARD_HOST=192.168.88.91
SIGNBOARD_PORT=5000
SIGNBOARD_BRIGHTNESS=10
SIGNBOARD_TEXT_COLOR=7
SIGNBOARD_BACK_COLOR=0
SIGNBOARD_TEXT_SIZE=2
SIGNBOARD_TEXT_SPEED=10

# ── 사이렌 (InterM HTTP REST + Digest 인증) ───────────────────────────────────
# 비어 있으면 사이렌 기능 비활성화
SIREN_HOST=
SIREN_PORT=80
SIREN_USER=
SIREN_PASSWORD=
SIREN_AUTO_STOP=10
