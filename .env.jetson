# ==============================================================================
# .env.jetson — Jetson Orin AGX 올인원 배포 환경 변수
#
# 사용 방법:
#   docker compose -f docker-compose.jetson.yml --env-file .env.jetson up -d --build
#
# 필수 수정 항목:
#   L4T_TAG  ← Jetson 에서 `cat /etc/nv_tegra_release` 로 JetPack 버전 확인
# ==============================================================================

# ── JetPack / L4T 버전 ────────────────────────────────────────────────────────
# JetPack 6.x (L4T R36.x):  r36.2.0-pth2.1-py3  ← 기본값
# JetPack 5.x (L4T R35.x):  r35.4.1-pth2.1-py3
L4T_TAG=r36.2.0-pth2.1-py3

# ── AI 추론 설정 ──────────────────────────────────────────────────────────────
# GStreamer 하드웨어 디코딩 활성화 (nvv4l2decoder 사용)
USE_GSTREAMER=1

# 추론 디바이스 (Jetson 은 항상 cuda)
AI_DEVICE=cuda

# 헬멧 감지 신뢰도 임계값 (0.0~1.0)
CONFIDENCE=0.5

# 사람/낙상 포즈 감지 신뢰도 임계값 (0.0~1.0)
POSE_CONFIDENCE=0.3

# AI 추론 주기 (매 N 프레임마다 실행, 성능-정확도 트레이드오프)
# Jetson Orin AGX (JetPack 6.2, CUDA 12.6) 권장: 2 (30fps 기준 약 10fps 추론)
FRAME_SKIP=2

# 목표 FPS
FPS=30

# RTSP 프레임 버퍼 크기
# 1: 최신 프레임만 유지 (지연 최소화, 지터 환경에서 드롭 증가)
# 2: 네트워크 지터 완충 (일반 CCTV 환경 권장 기본값)
# 3: 불안정한 네트워크 환경용
RTSP_BUFFER_SIZE=2

# 이벤트 디바운싱 간격(초) — 동일 이벤트 중복 발행 방지
DEBOUNCE=3.0

# ── Zone 설정 API (카메라별 위험구역 설정) ────────────────────────────────────
# 0 이면 비활성화, 8765 로 설정하면 http://<Jetson-IP>:8765 에서 접근 가능
ZONE_API_PORT=0

# ── Action Layer: 알람 쿨다운(초) ────────────────────────────────────────────
ACTION_ALARM_COOLDOWN=10

# ── 스피커 (InterM HTTP REST + Digest 인증) ───────────────────────────────────
# 비어 있으면 스피커 기능 비활성화
SPEAKER_HOST=192.168.88.92
SPEAKER_PORT=80
SPEAKER_USER=admin
SPEAKER_PASSWORD=sawwaveap123@
SPEAKER_VOLUME=10
SPEAKER_TTS_LANGUAGE=kor
SPEAKER_TTS_GENDER=female
SPEAKER_TTS_PITCH=100
SPEAKER_TTS_SPEED=100
SPEAKER_TTS_VOLUME=1

# ── 전광판 (Dabit TCP 소켓) ──────────────────────────────────────────────────
# 비어 있으면 전광판 기능 비활성화
SIGNBOARD_HOST=192.168.88.91
SIGNBOARD_PORT=5000
SIGNBOARD_BRIGHTNESS=10
SIGNBOARD_TEXT_COLOR=7
SIGNBOARD_BACK_COLOR=0
SIGNBOARD_TEXT_SIZE=2
SIGNBOARD_TEXT_SPEED=10

# ── 사이렌 (InterM HTTP REST + Digest 인증) ───────────────────────────────────
# 비어 있으면 사이렌 기능 비활성화
SIREN_HOST=
SIREN_PORT=80
SIREN_USER=
SIREN_PASSWORD=
SIREN_AUTO_STOP=10
