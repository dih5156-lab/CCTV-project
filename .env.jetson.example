# Jetson deployment example. Copy to .env.jetson and fill site-specific values.

L4T_TAG=r36.4.0

USE_GSTREAMER=1
USE_DEEPSTREAM=1
AI_DEVICE=cuda
FRAME_SKIP=2
FPS=30
RTSP_BUFFER_SIZE=2

DS_EVENT_MIN_INTERVAL_SEC=3.0
DS_YOLO_TASK=pose
DS_YOLO_CLASS_IDS=0
DS_YOLO_LABELS=person
DS_HELMET_ENABLED=1
DS_FACE_ENABLED=1
DS_APPEARANCE_ENABLED=1

FACE_RECOGNITION_BACKEND=opencv
FACE_SNAPSHOT_ENABLED=false
APPEARANCE_ENABLED=true
APPEARANCE_BACKEND=hsv
APPEARANCE_SAVE_CROPS=false

DS_PREVIEW_ENABLED=1
STREAM_API_ENABLED=1
STREAM_PORT=8769
STREAM_FPS=15
STREAM_JPEG_QUALITY=75

ZONE_API_PORT=8765
CAMERA_MODEL_API_PORT=8766
FACE_API_PORT=8767

ACTION_ALARM_COOLDOWN=10

AIOT_DB_NAME=aiot_sensor
AIOT_DB_USER=postgres
AIOT_DB_PASSWORD=
AIOT_ALLOW_UNKNOWN_DEVICES=true

MQTT_USER=
MQTT_PASSWORD=

# ./scripts/ensure_public_api_key.sh .env 로 자동 생성 가능
PUBLIC_API_KEY=
INTERNAL_SERVICE_TOKEN=
CORS_ORIGINS=
GRAFANA_ADMIN_PASSWORD=

SPEAKER_HOST=
SPEAKER_PORT=80
SPEAKER_USER=
SPEAKER_PASSWORD=
SPEAKER_VOLUME=10

SIGNBOARD_HOST=
SIGNBOARD_PORT=5000

SIREN_HOST=
SIREN_PORT=80
SIREN_USER=
SIREN_PASSWORD=
SIREN_AUTO_STOP=10
