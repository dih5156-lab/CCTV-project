# Jetson deployment example. Copy to .env.jetson and fill site-specific values.
# Start with: docker compose --env-file .env.jetson -f docker-compose.jetson.yml up -d --build

L4T_TAG=r36.4.0
DEEPSTREAM_ROOT=/opt/nvidia/deepstream
NVIDIA_LIB_ROOT=/usr/lib/aarch64-linux-gnu/nvidia
JETSON_TORCH_SITE_PACKAGES=/media/sawwave/Learning1/jetson-py310-cu126/site-packages

APP_ENV=development
USE_GSTREAMER=1
USE_DEEPSTREAM=1
AI_DEVICE=cuda
FRAME_SKIP=2
FPS=30
RTSP_BUFFER_SIZE=2

DEBOUNCE_SECONDS=3.0
DS_YOLO_TASK=pose
DS_YOLO_CLASS_IDS=0
DS_YOLO_LABELS=person
DS_HELMET_ENABLED=1
DS_FACE_ENABLED=1
DS_APPEARANCE_ENABLED=1

FACE_RECOGNITION_BACKEND=opencv
FACE_SNAPSHOT_ENABLED=false
APPEARANCE_ENABLED=true
APPEARANCE_BACKEND=hsv
APPEARANCES_DB=/app/data/runtime/appearances.db
APPEARANCE_CROP_DIR=/app/data/runtime/appearance_crops
APPEARANCE_SAVE_CROPS=false
FACE_SNAPSHOT_DIR=/app/data/runtime/face_snapshots

DS_PREVIEW_ENABLED=1
STREAM_API_ENABLED=1
STREAM_PORT=8769
STREAM_FPS=15
STREAM_JPEG_QUALITY=75

# 공공 falldata RF 모델 보조 검증.
# 운영 전환 전에는 shadow로 현장 로그를 모으고, confirm/borderline은 검토 후 켜세요.
FALLDATA_AUX_ENABLED=true
FALLDATA_AUX_MODE=shadow
FALLDATA_AUX_THRESHOLD=0.7
FALLDATA_AUX_FALL_CLASS_INDEX=0
FALLDATA_AUX_MIN_NONZERO_FRAMES=30
FALLDATA_AUX_BUFFER_FRAMES=600
FALLDATA_AUX_MAX_EXTRACT_FRAMES=120
FALLDATA_AUX_TIMEOUT_SECONDS=30
FALLDATA_AUX_COOLDOWN_SECONDS=10
FALLDATA_AUX_FAIL_OPEN_ON_UNAVAILABLE=true
FALLDATA_AUX_CONFIRM_BORDERLINE=false
FALLDATA_AUX_COMPARE_VETO_ENABLED=false
FALLDATA_AUX_MEDIAPIPE_PYTHON=/app/.venv-mediapipe/bin/python
FALLDATA_AUX_MODEL_PYTHON=/app/.venv-falldata/bin/python
FALLDATA_AUX_MODEL_PATH=/app/falldata/2. AI학습모델파일/영상/낙상분류/FNF_RF_SMOTE_CAM_1.pkl
FALL_SHADOW_REVIEW_LOG_PATH=/app/data/logs/fall_shadow_review.jsonl
FALL_SHADOW_SAVE_CLIPS=false
FALL_SHADOW_CLIP_DIR=/app/data/fall_review_clips
FALL_SHADOW_NEAR_MISS_LOG=false
FALL_SHADOW_NEAR_MISS_COOLDOWN_SECONDS=10

ZONE_API_PORT=8765
CAMERA_MODEL_API_PORT=8766
FACE_API_PORT=8767

ACTION_ALARM_COOLDOWN=10
DB_PATH=/app/data/runtime/action_events.db
ALERT_LOG_PATH=/app/data/logs/alert_api_events.jsonl
SENSOR_LOG_PATH=/app/data/logs/sensor_readings.jsonl
ALERT_FALLBACK_LOG=/app/data/logs/public_api_fallback.jsonl

AIOT_DB_NAME=aiot_sensor
AIOT_DB_USER=postgres
AIOT_DB_PASSWORD=
AIOT_ALLOW_UNKNOWN_DEVICES=true
EDGEX_OUTBOX_DB=/data/runtime/edgex_outbox.db
MQTT_EVENT_OUTBOX_DB=/app/data/runtime/mqtt_event_outbox.db

MQTT_USER=
MQTT_PASSWORD=

# ./scripts/ops/ensure_public_api_key.sh .env 로 자동 생성 가능
PUBLIC_API_KEY=
PUBLIC_API_ALLOW_QUERY_KEY=0
REQUIRE_PUBLIC_API_KEY=0
INTERNAL_SERVICE_TOKEN=
CORS_ORIGINS=
REQUIRE_CORS_ORIGINS=0
STREAM_API_TOKEN=
REQUIRE_STREAM_API_TOKEN=0
RATE_LIMIT_ENABLED=true
GRAFANA_ADMIN_PASSWORD=

SPEAKER_HOST=
SPEAKER_PORT=80
SPEAKER_USER=
SPEAKER_PASSWORD=
SPEAKER_VOLUME=10

SIGNBOARD_HOST=
SIGNBOARD_PORT=5000

SIREN_HOST=
SIREN_PORT=80
SIREN_USER=
SIREN_PASSWORD=
SIREN_AUTO_STOP=10
