# Jetson deployment example. Copy to .env.jetson and fill site-specific values.
# Start with: docker compose --env-file .env.jetson -f docker-compose.jetson.yml up -d --build

L4T_TAG=r36.4.0
DEEPSTREAM_ROOT=/opt/nvidia/deepstream
NVIDIA_LIB_ROOT=/usr/lib/aarch64-linux-gnu/nvidia
# 보드별 모델/설정/venv/캐시 분리. NX 전환 시 .env.jetson.nx16.example 값을 병합한다.
MODELS_HOST_PATH=./models
DEEPSTREAM_CONFIG_HOST_PATH=./config/deepstream
JETSON_TORCH_VENV_HOST_PATH=./.venv-jetson-train
TRT_CACHE_VOLUME=edgex-jetson_trt-cache

APP_ENV=development
USE_GSTREAMER=1
USE_DEEPSTREAM=1
AI_DEVICE=cuda
FRAME_SKIP=2
FPS=30
RTSP_BUFFER_SIZE=2

DEBOUNCE_SECONDS=3.0
DS_YOLO_TASK=pose
DS_YOLO_CLASS_IDS=0
DS_YOLO_LABELS=person
# 운영 기본값. 문제 발생 시 legacy로 바꾸고 AI 엔진만 재시작하면 즉시 롤백됩니다.
DS_YOLO_POSTPROCESS_MODE=vectorized
DS_DISPLAY=:1
DS_HELMET_ENABLED=1
DS_FACE_ENABLED=1
DS_APPEARANCE_ENABLED=1
# 동일 추적 인물의 얼굴·의상·색상 분석 간격. 0은 제한 해제이며 탐지/이벤트 저장과 별개다.
DS_CONTEXT_MIN_INTERVAL_SEC=0.5

# DeepStream pose fall tuning.
# 3.0 preserves sensitivity. Higher values reduced false positives in sample replay,
# but threshold-only tuning missed too many fall samples.
DS_FALL_SCORE_THRESHOLD=3.0
# Crop-pose POC only. Keep disabled until person+pose FPS/memory validation passes.
POSE_CROP_MODE=0
# DeepStream crop-Pose topology (Person Primary + Pose/Helmet/Appearance SGIE)
DS_CROP_POSE_ENABLED=0
DS_CROP_PERSON_INTERVAL=0
# Person bbox와 SGIE crop 좌표가 맞도록 실제 입력/운영 해상도와 일치시킨다.
DS_STREAM_WIDTH=1920
DS_STREAM_HEIGHT=1080
# 현재 SGIE TensorRT 엔진은 static batch=1이다. 4/8 batch 엔진으로 변환한 뒤에만 올린다.
DS_POSE_SGIE_BATCH_SIZE=1
DS_HELMET_SGIE_BATCH_SIZE=1
DS_PPHUMAN_SGIE_BATCH_SIZE=1
DS_FALL_ANGLE_HORIZONTAL=55
DS_FALL_ANGLE_INVERTED=125
DS_FALL_BBOX_ASPECT_RATIO=1.35
DS_FALL_SPAN_BBOX_ASPECT_RATIO=1.20
DS_FALL_KEYPOINT_SPAN_RATIO=0.55
DS_FALL_ENABLE_FOLDED_POSE=false
DS_FALL_FOLDED_POSE_MAX_SPAN_RATIO=0.30
DS_FALL_SUPPRESS_SITTING_LIKE_POSE=true
DS_FALL_SITTING_LIKE_ASPECT_RATIO=1.45
DS_FALL_MIN_KEYPOINT_CONFIDENCE=0.25
DS_FALL_MIN_HIP_CONFIDENCE=0.25
DS_FALL_MIN_LEG_CONFIDENCE=0.35

FACE_RECOGNITION_BACKEND=opencv
# 상용 TensorRT 얼굴 경로 활성화 시 commercial_tensorrt로 변경
COMMERCIAL_FACE_MODEL_DIR=models/commercial_face
COMMERCIAL_FACE_DATABASE=data/runtime/commercial_faces.db
FACE_SNAPSHOT_ENABLED=false
APPEARANCE_ENABLED=true
APPEARANCE_BACKEND=hsv
APPEARANCES_DB=/app/data/runtime/appearances.db
APPEARANCE_CROP_DIR=/app/data/runtime/appearance_crops
APPEARANCE_SAVE_CROPS=false
FACE_SNAPSHOT_DIR=/app/data/runtime/face_snapshots

DS_PREVIEW_ENABLED=1
# RTSP 지터 버퍼 지연 패킷 폐기: 기본 SDK 동작 유지. 격리 재생 대조에서만 false 시험.
# false는 압축 영상 손상을 줄일 수 있으나 처리량 부족 시 지연/메모리가 누적될 수 있습니다.
# DS_RTSP_DROP_ON_LATENCY=true
STREAM_API_ENABLED=1
STREAM_PORT=8769
STREAM_FPS=15
STREAM_JPEG_QUALITY=75

# DeepStream inline pose RF 모델 보조 검증.
# 운영 전환 전에는 shadow로 현장 로그를 모으고, confirm/borderline은 검토 후 켜세요.
FALLDATA_AUX_ENABLED=true
FALLDATA_AUX_MODE=shadow
FALLDATA_AUX_INLINE_POSE_RF=true
FALLDATA_AUX_THRESHOLD=0.7
FALLDATA_AUX_FALL_CLASS_INDEX=0
FALLDATA_AUX_MIN_NONZERO_FRAMES=30
FALLDATA_AUX_MIN_POSE_FRAMES=10
FALLDATA_AUX_BUFFER_FRAMES=600
FALLDATA_AUX_CLIP_BUFFER_ENABLED=false
FALLDATA_AUX_CLIP_BUFFER_WIDTH=640
FALLDATA_AUX_CLIP_BUFFER_HEIGHT=360
FALLDATA_AUX_MAX_EXTRACT_FRAMES=120
FALLDATA_AUX_TIMEOUT_SECONDS=30
FALLDATA_AUX_COOLDOWN_SECONDS=10
FALLDATA_AUX_FAIL_OPEN_ON_UNAVAILABLE=true
FALLDATA_AUX_CONFIRM_BORDERLINE=true
FALLDATA_AUX_CONFIRM_MAX_FALL_SCORE=4.5
FALLDATA_AUX_COMPARE_VETO_ENABLED=true
FALLDATA_AUX_COMPARE_VETO_MIN_FALL_SCORE=3.0
FALLDATA_AUX_COMPARE_MODEL_PATH=models/experiments/yolo_pose_fall_cam2_continuous_200_80_640.pkl
FALLDATA_AUX_COMPARE_MODEL_KIND=yolo_pose_rf
# 레거시 MediaPipe RF 재현 설정은 config/legacy/falldata-mediapipe.env.example에 분리되어 있습니다.
FALLDATA_AUX_TEMPORAL_PYTHON=/app/.venv-jetson-train/bin/python
# FALLDATA_AUX_TEMPORAL_COMPARE_MODEL_PATH=/app/models/experiments/fall_temporal_hybrid_all_diverse_cache_t060.pt
# 새 장비에서도 루트 별칭 없이 모델 폴더만 복사해 사용할 수 있게 한다.
FALLDATA_AUX_TEMPORAL_POSE_MODEL_PATH=/app/models/fall/yolov8n-pose.pt
# 현장 비교 기준의 Pose 입력 크기. 변경 시 동일 영상으로 재검증한다.
FALLDATA_AUX_TEMPORAL_POSE_IMGSZ=640
# 격리 시험 후 선택 적용: 모델 재사용 자식. 오류/timeout 시 종료하고 다음 호출에서 다시 로딩한다.
FALLDATA_AUX_TEMPORAL_WORKER_ENABLED=false
FALLDATA_AUX_TEMPORAL_SLIDING_WINDOW_SIZE=0
FALLDATA_AUX_TEMPORAL_SLIDING_WINDOW_STRIDE=5
FALLDATA_AUX_TEMPORAL_MIN_CONFIRMED_WINDOWS=1
FALLDATA_AUX_TEMPORAL_NEAR_MISS_SHADOW_ENABLED=false
FALL_SHADOW_REVIEW_LOG_PATH=/app/data/fall_dataset/annotations/review.jsonl
FALL_SHADOW_SAVE_CLIPS=false
FALL_SHADOW_CLIP_DIR=/app/data/fall_dataset/clips/pending
FALL_SHADOW_NEAR_MISS_LOG=true
FALL_SHADOW_NEAR_MISS_COOLDOWN_SECONDS=10

ZONE_API_PORT=8765
CAMERA_MODEL_API_PORT=8766
FACE_API_PORT=8767

ACTION_ALARM_COOLDOWN=10
EDGEX_SHADOW_ENABLED=false
# direct, shadow, edgex 중 하나를 지정하며 비워두면 기존 Shadow 설정을 따릅니다.
EDGEX_COMMAND_MODE=
# EdgeX 또는 Shadow에서 허용할 출력 장치만 지정합니다. 예: signboard
EDGEX_ALLOWED_DEVICES=
EDGEX_JETSON_ID=jetson-01
EDGEX_COMMAND_TOPIC_PREFIX=edgex/commands/cctv
EDGEX_RESULT_TOPIC_PREFIX=edgex/results/cctv
EDGEX_COMMAND_RESULT_DB=/app/data/runtime/edgex_command_results.db
EDGEX_DEVICE_REGISTRY_PATH=
SPEAKER_DEVICE_ID=cctv-speaker-01
SPEAKER_DRY_RUN=false
SPEAKER_SERVICE_PORT=59991
SIREN_SERVICE_PORT=59992
SIGNBOARD_SERVICE_PORT=59993
DB_PATH=/app/data/runtime/action_events.db
ALERT_LOG_PATH=/app/data/logs/alert_api_events.jsonl
SENSOR_LOG_PATH=/app/data/logs/sensor_readings.jsonl
ALERT_FALLBACK_LOG=/app/data/logs/public_api_fallback.jsonl

AIOT_DB_NAME=aiot_sensor
AIOT_DB_USER=postgres
AIOT_DB_PASSWORD=
AIOT_ALLOW_UNKNOWN_DEVICES=true
EDGEX_OUTBOX_DB=/data/runtime/edgex_outbox.db
MQTT_EVENT_OUTBOX_DB=/app/data/runtime/mqtt_event_outbox.db
SIREN_DEVICE_ID=cctv-siren-01
SIREN_DRY_RUN=false
SIGNBOARD_DRY_RUN=false

MQTT_USER=
MQTT_PASSWORD=
MQTT_BIND_HOST=127.0.0.1

# ./scripts/ops/ensure_public_api_key.sh .env 로 자동 생성 가능
PUBLIC_API_KEY=
PUBLIC_API_ALLOW_QUERY_KEY=0
REQUIRE_PUBLIC_API_KEY=0
PUBLIC_API_BIND_HOST=127.0.0.1

# LAN에서 Grafana를 직접 접속할 때만 0.0.0.0으로 설정합니다.
# 인터넷에 직접 공개하지 말고 방화벽/VPN으로 접근을 제한하세요.
GRAFANA_BIND_HOST=127.0.0.1
GRAFANA_ROOT_URL=http://localhost:3001
PUBLIC_DEMO_BIND_HOST=127.0.0.1
INTERNAL_SERVICE_TOKEN=
CORS_ORIGINS=
REQUIRE_CORS_ORIGINS=0
STREAM_API_TOKEN=
REQUIRE_STREAM_API_TOKEN=0
RATE_LIMIT_ENABLED=true
GRAFANA_ADMIN_PASSWORD=

MEDIA_BIND_HOST=127.0.0.1
MEDIA_API_BIND_HOST=127.0.0.1

SPEAKER_HOST=
SPEAKER_PORT=80
SPEAKER_USER=
SPEAKER_PASSWORD=
SPEAKER_VOLUME=10

SIGNBOARD_HOST=
SIGNBOARD_PORT=5000
SIGNBOARD_DEVICE_ID=cctv-signboard-01

SIREN_HOST=
SIREN_PORT=80
SIREN_USER=
SIREN_PASSWORD=
SIREN_AUTO_STOP=10

# EdgeX 양방향 AI 검색/미디어 요청 (기본 비활성화)
AIOT_COMMANDS_ENABLED=false
AIOT_JETSON_ID=jetson-01
AIOT_COMMAND_TOPIC_PREFIX=edgex/commands/cctv
AIOT_ALLOWED_UPLOAD_HOSTS=
AIOT_QUERY_MAX_RESULTS=20
AIOT_LIVE_WINDOW_SECONDS=30
AIOT_METRICS_PORT=9105
