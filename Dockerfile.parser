# AIoT TLV Parser Dockerfile
# LoRa 센서 MQTT 수신 → TLV 파싱 → DB 저장 + EdgeX MQTT 발행

FROM python:3.10-slim-bookworm

WORKDIR /app

# PostgreSQL 클라이언트 라이브러리 (psycopg2-binary 는 자체 포함이지만 혹시 모를 OS dep)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

# 의존성 먼저 복사 (레이어 캐싱 최적화)
COPY parser-python/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 소스 복사
COPY parser-python/ .

# 비루트 사용자 생성 (보안 강화)
RUN groupadd -r -g 2001 cctv && useradd -r -g cctv -u 2003 cctv \
    && mkdir -p /data && chown -R cctv:cctv /app /data \
    && chmod 2775 /data

USER cctv

ENV PYTHONIOENCODING=utf-8
ENV PYTHONUTF8=1
ENV PYTHONUNBUFFERED=1

# Flask health endpoint: 4000 (ROUTER 기본값)
EXPOSE 4000

CMD ["python", "main.py"]
