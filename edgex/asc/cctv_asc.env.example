# CCTV ASC 하이브리드 운영용 환경변수 템플릿
# 사용 방법:
# 1) docker compose 서비스(app-rules-engine 계열)에 env_file로 연결
# 2) 서비스 내부 Writable/Pipeline 구성을 이 값으로 치환

# 입력 토픽 (Kuiper 후단 소비 기준)
ASC_INPUT_TOPIC=cctv/rules/intrusion/#

# 토픽별 라우팅 대상
ASC_TOPIC_FILTERED=cctv/rules/intrusion/filtered
ASC_TOPIC_PERSISTED=cctv/rules/intrusion/persisted
ASC_TOPIC_CRITICAL=cctv/rules/intrusion/critical

# 외부 API (예: 내부 alert api)
ASC_ALERT_API_URL=http://cctv-alert-api:8000/api/alerts

# MQTT 브로커
ASC_MQTT_BROKER=tcp://edgex-mqtt-broker:1883
ASC_MQTT_QOS=0
ASC_MQTT_RETAIN=false

# 운영 정책
# critical: 즉시 알람
ASC_POLICY_CRITICAL_ENABLED=true
# persisted: 운영 알림
ASC_POLICY_PERSISTED_ENABLED=true
# filtered: 통계/대시보드 적재
ASC_POLICY_FILTERED_ENABLED=true

# 다중카메라 정책
# camera_id를 유지한 상태로 라우팅해야 후단 액션/관제 분리가 가능
ASC_REQUIRE_CAMERA_ID=true

# 메모
# - 5초 지속 조건은 Kuiper에서 판정합니다.
# - ASC는 전송/라우팅/운영 분리를 담당합니다.
