# =============================================================================
# aiot-parser 환경 변수 예시
# 실제 사용 시: cp parser-python/.env.example parser-python/.env
# =============================================================================

# =============================================================================
# 서버 설정
# =============================================================================
ROUTER=3500
APP_VERSION=1.0.0

# =============================================================================
# PostgreSQL 데이터베이스
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PW=yourpassword
DB_NAME=aiot_sensor
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT=30s
DB_CONNECT_TIMEOUT=2s
PGDEBUG=false

# =============================================================================
# MQTT 브로커 (복수 브로커 지원)
# =============================================================================

# 프록시 MQTT (중계 브로커)
PROXY_MQTT_HOST=localhost
PROXY_MQTT_PORT=1883
PROXY_MQTT_ID=
PROXY_MQTT_PW=

# NsPark LoRa 네트워크 서버 MQTT
NS_PARK_MQTT_HOST=localhost
NS_PARK_MQTT_PORT=1883
NS_PARK_MQTT_ID=

# 랩 테스트 MQTT
LAB_MQTT_HOST=localhost
LAB_MQTT_PORT=1883
LAB_MQTT_ID=

# 추가 랩 테스트 MQTT
LAB_TEST_MQTT_HOST=localhost
LAB_TEST_MQTT_PORT=1883
LAB_TEST_MQTT_ID=

# 로컬 MQTT
LOCAL_MQTT_HOST=localhost
LOCAL_MQTT_PORT=1883
LOCAL_MQTT_ID=
LOCAL_MQTT_PW=

# 공통 MQTT/API 인증 토큰 (NS_PARK, LAB, 배치 API 공유)
NC_PW=

# =============================================================================
# 배치 작업 (디바이스 목록 주기적 갱신)
# =============================================================================
NC_API_RUI=http://localhost:3000/api/v1/devices
NC_APPLICATION_IDS=
BATCH_INTERVAL=1h
BATCH_MAX_RETRIES=3
BATCH_ENABLED=true
BATCH_SKIP_TLS_VERIFY=false

# =============================================================================
# EdgeX 연동 (docker-compose 환경에서는 environment 블록으로 덮어씌워짐)
# =============================================================================
EDGEX_MQTT_HOST=edgex-mqtt-broker
EDGEX_MQTT_PORT=1883
EDGEX_CORE_DATA_URL=http://edgex-core-data:59880
EDGEX_OUTBOX_DB=/data/edgex_outbox.db
EDGEX_OUTBOX_RETRY_INTERVAL=30
